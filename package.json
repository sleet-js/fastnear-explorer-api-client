{
  "name": "@sleet-js/fastnear-explorer-api-client",
  "version": "0.1.5",
  "description": "Clean TypeScript client for the FastNear Explorer API, with a pure transaction parser.",
  "license": "MIT",
  "homepage": "https://sleet-js.near.page",
  "repository": {
    "type": "git",
    "url": "https://github.com/sleet-js/fastnear-explorer-api-client.git"
  },
  "type": "module",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "publishConfig": {
    "access": "public"
  },
  "files": [
    "README.md",
    "GUIDE.md",
    "LICENSE",
    "dist/**/*"
  ],
  "scripts": {
    "typecheck": "tsc --noEmit",
    "build": "rm -f .tsbuildinfo && bun run tsc --build tsconfig.build.json --force",
    "clean": "bun run tsc --build --clean && rm -rf dist .tsbuildinfo",
    "test": "bun bin/parse_encodings.ts && bun bin/parse_fastfs.ts",
    "verify": "bun bin/parse_encodings.ts && bun bin/parse_fastfs.ts && bun bin/parse_verify.ts",
    "version:sync": "bun run scripts/version-sync.ts",
    "version:dry-run": "bun run scripts/version-sync.ts --dry-run",
    "release:version": "bun run scripts/release-version.ts"
  },
  "devDependencies": {
    "@types/bun": "latest",
    "@types/node": "^26.6.6",
    "typescript": "^5.9.3"
  },
  "peerDependencies": {
    "typescript": "^5"
  }
}
